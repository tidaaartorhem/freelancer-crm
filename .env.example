# Database — local dev uses SQLite, no setup needed.
# To use PostgreSQL instead, set a postgres:// URL and see README.
DATABASE_URL="file:./dev.db"

# AI provider for the pipeline assistant (optional — the app works with
# zero keys via the built-in mock provider).
# Supported: "mock" (default), "openai", "anthropic"
AI_PROVIDER="mock"
AI_MODEL=""

# OpenAI (only needed when AI_PROVIDER=openai; any free-tier key works)
OPENAI_API_KEY=""

# Anthropic (only needed when AI_PROVIDER=anthropic; any free-tier key works)
ANTHROPIC_API_KEY=""
